# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key, sb_publishable_...>
# Server-side (/api on Vercel) — same values as above
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable key>
# Only for scripts/upload-demo-images.mjs
DEMO_MEDIA_PASSWORD=<password of the @chronos demo media account>
